# Turso: `turso db show reading-log --url` / `turso db tokens create reading-log`.
# For local development a file works too: TURSO_DATABASE_URL=file:local.db (no token).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# The password you type to get in, and a long random string that signs the
# session cookie (e.g. `openssl rand -hex 32`). Changing either logs you out.
APP_PASSWORD=
AUTH_SECRET=

# Notion internal integration token, with both databases connected to it.
NOTION_TOKEN=
# Data source ids (not database ids) of the two libraries.
NOTION_DATA_SOURCE_GENERAL=
NOTION_DATA_SOURCE_INFORMATICA=
